resources/
# ...but keep the bundled card stylesheet, which lives in a package directory
# named "resources" (Issue #44). Negate the dir + just its tracked file types,
# so the broad rule above doesn't drop it (and __pycache__ stays ignored).
!anki_miner/services/dictionary/resources/
!anki_miner/services/dictionary/resources/__init__.py
!anki_miner/services/dictionary/resources/*.css
# Same for the GUI theme JSONs (Issue #27 family, #48 Dracula). Climb each
# parent dir the broad resources/ rule excludes so themes/*.json can be tracked.
!anki_miner/gui/resources/
!anki_miner/gui/resources/styles/
!anki_miner/gui/resources/styles/themes/
!anki_miner/gui/resources/styles/themes/*.json
# Same for the bundled name wordsets (Issue #59), relocated out of gui/resources
# into their own non-GUI data package. Negate the package dirs + tracked file types.
!anki_miner/resources/
!anki_miner/resources/__init__.py
!anki_miner/resources/wordsets/
!anki_miner/resources/wordsets/__init__.py
!anki_miner/resources/wordsets/*.txt
TECH_DEBT_AUDIT.md

# OS
.DS_Store
Thumbs.db

# Scratch output dir for demo-GIF regeneration (see gifs/gif-tools/README.md).
# The tooling and the committed gifs/*.gif|mp4 are tracked; only scratch is hidden.
gifs/test-gifs/

# Logo design scratch (draft SVGs, downloaded fonts, generator scripts).
# Only the picked logo is committed, into anki_miner/gui/resources/icons/.
logo_drafts/
# subagent-driven-development artifacts
sdd/
