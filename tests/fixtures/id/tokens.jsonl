{"id": "id01", "sentence": "Saya sedang membaca buku di rumah.", "tokens": [["Saya", "WORD", "stopword", "saya"], ["sedang", "WORD", "stopword", "sedang"], ["membaca", "WORD", "", "membaca"], ["buku", "WORD", "", "buku"], ["di", "WORD", "stopword", "di"], ["rumah", "WORD", "", "rumah"]], "note": "smoke sentence; saya sedang di are stopwords"}
{"id": "id02", "sentence": "Buku-buku itu dibeli di Jakarta.", "tokens": [["Buku-buku", "WORD", "", "buku-buku"], ["itu", "WORD", "stopword", "itu"], ["dibeli", "WORD", "", "dibeli"], ["di", "WORD", "stopword", "di"], ["Jakarta", "PROPN", "", "jakarta"]], "note": "reduplication is one token; dibeli stays a surface; Jakarta mid-sentence is PROPN"}
{"id": "id03", "sentence": "Gue nggak ngerti, beliin aja bukunya!", "tokens": [["Gue", "WORD", "stopword", "gue"], ["nggak", "WORD", "stopword", "nggak"], ["ngerti", "WORD", "", "ngerti"], ["beliin", "WORD", "", "beliin"], ["aja", "WORD", "stopword", "aja"], ["bukunya", "WORD", "", "bukunya"]], "note": "colloquial function words are stopwords; ngerti, beliin, bukunya are words"}
