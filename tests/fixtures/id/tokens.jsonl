{"id": "id05", "sentence": "UU itu yg baru disahkan DPR.", "tokens": [["UU", "PROPN", "", "uu"], ["itu", "WORD", "stopword", "itu"], ["yg", "WORD", "stopword", "yg"], ["baru", "WORD", "stopword", "baru"], ["disahkan", "WORD", "", "disahkan"], ["DPR", "PROPN", "", "dpr"]], "note": "acronyms are PROPN anywhere; yg is a stopword through its formal yang"}
{"id": "id06", "sentence": "Kemarin dia beli oleh-oleh dirumah.", "tokens": [["Kemarin", "WORD", "", "kemarin"], ["dia", "WORD", "stopword", "dia"], ["beli", "WORD", "", "beli"], ["oleh-oleh", "WORD", "", "oleh-oleh"], ["dirumah", "WORD", "", "dirumah"]], "note": "sentence-initial capital is a word; dirumah (typo) is a word"}
{"id": "id07", "sentence": "SAYA TIDAK TAHU!", "tokens": [["SAYA", "WORD", "stopword", "saya"], ["TIDAK", "WORD", "stopword", "tidak"], ["TAHU", "WORD", "stopword", "tahu"]], "note": "an all-caps cue gets no PROPN"}
{"id": "id08", "sentence": "Okay guys, anak2nya datang 3 kali.", "tokens": [["Okay", "LATIN_OTHER", "", "okay"], ["guys", "LATIN_OTHER", "", "guys"], ["anak2nya", "WORD", "", "anak2nya"], ["datang", "WORD", "", "datang"], ["3", "NUM", "", "3"], ["kali", "WORD", "", "kali"]], "note": "English stoplist; R3 X2nya is a word; a digit token is NUM"}
{"id": "id09", "sentence": "- Kamu mau ke mana? - Ke Bali.", "tokens": [["Kamu", "WORD", "stopword", "kamu"], ["mau", "WORD", "", "mau"], ["ke", "WORD", "stopword", "ke"], ["mana", "WORD", "stopword", "mana"], ["Ke", "WORD", "stopword", "ke"], ["Bali", "PROPN", "", "bali"]], "note": "a question mark starts a sentence; Bali after it is PROPN"}
