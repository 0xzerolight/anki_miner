{"id": "id11", "sentence": "Dr. Budi membeli buku, pensil, dll. di Jl. Sudirman.", "tokens": [["Dr", "X", "", "dr"], ["Budi", "PROPN", "", "budi"], ["membeli", "WORD", "", "membeli"], ["buku", "WORD", "", "buku"], ["pensil", "WORD", "", "pensil"], ["dll", "X", "", "dll"], ["di", "WORD", "stopword", "di"], ["Jl", "X", "", "jl"], ["Sudirman", "PROPN", "", "sudirman"]], "note": "an abbreviation before its dot is X and its dot ends no sentence"}
