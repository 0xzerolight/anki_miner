        "compounds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compoundCase"}},
        "dictionaries": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/dictionaryCase"}},
        "frequency": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frequencyCase"}},
        "pitch": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pitchCase"}},
        "cards": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/cardCase"}}
      }
    }
  }
