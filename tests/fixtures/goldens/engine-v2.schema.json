                    "type": "object",
                    "additionalProperties": false,
                    "required": ["assetId", "status", "actualFilename"],
                    "properties": {
                      "assetId": {"$ref": "#/$defs/opaqueId"},
                      "status": {"const": "stored"},
                      "actualFilename": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rewritten_definition",
            "rewritten_glossary",
            "route",
            "normal_duplicate_options",
            "allow_duplicate_options",
            "create_notes_request",
            "create_notes_result"
          ],
          "properties": {
            "rewritten_definition": {"type": "string", "minLength": 1},
            "rewritten_glossary": {"type": "string", "minLength": 1},
            "route": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deck_name", "model_name", "tags", "card_type", "card_type_field"],
              "properties": {
                "deck_name": {"type": "string", "minLength": 1},
                "model_name": {"type": "string", "minLength": 1},
                "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "card_type": {"type": "string", "minLength": 1},
                "card_type_field": {"type": "string", "minLength": 1}
              }
            },
            "normal_duplicate_options": {"type": "null"},
            "allow_duplicate_options": {
              "const": {"allowDuplicate": true, "duplicateScope": "deck"}
            },
            "create_notes_request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "requestId",
                "deckName",
                "modelName",
                "firstFieldName",
                "notes"
              ],
              "properties": {
                "runId": {"$ref": "#/$defs/opaqueId"},
                "requestId": {"$ref": "#/$defs/opaqueId"},
                "deckName": {"type": "string", "minLength": 1},
                "modelName": {"type": "string", "minLength": 1},
                "firstFieldName": {"type": "string", "minLength": 1},
                "notes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "clientNoteId",
                      "fieldOrder",
                      "fields",
                      "tags",
                      "mediaBindings",
                      "duplicateCandidate"
                    ],
                    "properties": {
                      "clientNoteId": {"$ref": "#/$defs/opaqueId"},
                      "fieldOrder": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "fields": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"$ref": "#/$defs/field"}
                      },
                      "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
                      "mediaBindings": {
                        "type": "array",
                        "minItems": 3,
                        "items": {"$ref": "#/$defs/mediaBinding"}
                      },
                      "duplicateCandidate": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["key", "firstField", "occurrence"],
                        "properties": {
                          "key": {"type": "string", "minLength": 1},
                          "firstField": {"type": "string", "minLength": 1},
                          "occurrence": {"type": "integer", "minimum": 0}
                        }
                      }
                    }
                  }
                }
              }
            },
            "create_notes_result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "requestId", "results"],
              "properties": {
                "runId": {"$ref": "#/$defs/opaqueId"},
                "requestId": {"$ref": "#/$defs/opaqueId"},
                "results": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["clientNoteId", "status", "noteId"],
                    "properties": {
                      "clientNoteId": {"$ref": "#/$defs/opaqueId"},
                      "status": {"const": "created"},
                      "noteId": {"type": "integer", "minimum": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
