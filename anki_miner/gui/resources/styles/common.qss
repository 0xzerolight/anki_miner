/*
 * Common Base Styles for Anki Miner
 * Shared styles that apply across all themes
 *
 * Variables from _variables.py are substituted at load time:
 * - ${font-size-*}: h1, h2, h3, body, body-sm, caption, small, stat-value, icon-large,
 *   japanese-body, japanese-feature
 * - ${font-family-*}: interface, mono, japanese — resolved from the platform's own
 *   font database by gui/utils/fonts.py (decision D44-B). Never a hard-coded stack.
 * - ${spacing-*}: xxs, xs, sm, md, lg, xl
 * - ${border-radius-*}: small, default, large
 */

/* ============== BASE WIDGET STYLES ============== */

QWidget {
    font-family: ${font-family-interface};
    font-size: ${font-size-body}px;
    font-weight: 400;
}


QMainWindow {
    font-size: ${font-size-body}px;
}

/* ============== TYPOGRAPHY HELPERS ============== */

QLabel#heading1 {
    font-size: ${font-size-h1}px;
    font-weight: 700;
}

QLabel#heading2 {
    font-size: ${font-size-h2}px;
    font-weight: 600;
}

QLabel#heading3 {
    font-size: ${font-size-h3}px;
    font-weight: 600;
}

/* `caption` is a CHIP, not simply small text: it carries horizontal padding and
   a radius so a short status word can take a tinted background (the theme
   gallery's "Active", the header's profile name). Small secondary text that is
   NOT a chip wants `row-meta` below -- naming it `caption` indents it 8px away
   from whatever it is meant to sit beside. */
QLabel#caption {
    font-size: ${font-size-caption}px;
    padding: 2px ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
}

/* A dialog's own subtitle sits directly under its title and must share that
   title's left edge, so it carries no horizontal padding. */
QLabel#dialog-subtitle {
    font-size: ${font-size-body-sm}px;
}

/* Chain priority rows (D13): title on line one, the row's own facts below it.
   `row-meta` is the same idea generalised -- muted, caption-sized text that
   states a row's own facts beside or below it, with no padding of its own. */
QLabel#chain-row-title {
    font-weight: 500;
}

QLabel#chain-row-meta,
QLabel#row-meta,
QLabel#chain-row-warning {
    font-size: ${font-size-caption}px;
}

QLabel#small {
    font-size: ${font-size-small}px;
    padding: 2px 0;
    min-height: 16px;
}

QLabel#field-label {
    padding: ${spacing-xxs}px ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
}

/* ---- Japanese content (D45-B) -------------------------------------------
   Japanese is content, not chrome: an explicitly Japanese face so kanji take
   Japanese rather than Chinese glyph forms, at a reading size above the
   surrounding interface text. The attribute selector outranks the QWidget type
   rule above, which is the only way a widget escapes the interface font — a
   stylesheet beats setFont() for family and size.

   Set the property through gui/utils/fonts.apply_japanese_font(); nothing else
   writes it. Leading is NOT here: Qt ignores line-height, so it is applied as a
   QTextBlockFormat from Python. */
*[japanese="body"] {
    font-family: ${font-family-japanese};
    font-size: ${font-size-japanese-body}px;
}

*[japanese="feature"] {
    font-family: ${font-family-japanese};
    font-size: ${font-size-japanese-feature}px;
}

/* ============== BUTTON BASE STYLES ============== */

/* Every button carries the same 1px box in every role. Only its colour changes,
   so keyboard focus can recolour the border without resizing anything — tabbing
   along a row of buttons must not reflow the row.

   No `min-height` (D40): a pixel floor is generous at 100% text and below the
   glyphs at 150%, so the height is one line of text plus this padding, and it
   tracks the UI text scale by construction. */
QPushButton {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-default}px;
    font-weight: 500;
    border: 1px solid;
}

/* Disabled buttons are dimmed by the themed QPushButton:disabled colour rule
   further down, not here: Qt's widget style engine ignores `opacity`. */

/* Qt's own focus rect lands inside the rounded box and reads as noise. The
   focus ring is the border recolour in the theme rules below. */
QPushButton:focus {
    outline: none;
}

/* Button variants (D41). `secondary` deliberately has no rules of its own: the
   quiet bordered control IS the base button, so the object name is only how a
   call site says out loud that it meant the ordinary one. */
QPushButton#primary,
QPushButton#danger,
QPushButton#critical {
    font-weight: 600;
}

/* Icon buttons */
/* Glyph-only controls pinned to their own height (the chain editor's reorder
   arrows and its trash). The global inset above is measured for a word, so on a
   square box it leaves the glyph a negative content width and clips it away. */
QPushButton[square="true"] {
    padding: ${spacing-xxs}px;
}

QPushButton#iconButton {
    min-width: ${spacing-xl}px;
    min-height: ${spacing-xl}px;
    max-width: ${spacing-xl}px;
    max-height: ${spacing-xl}px;
    padding: ${spacing-xxs}px;
    border-radius: ${border-radius-default}px;
}

/* Theme gallery: the favorite star on a card and on a family header. Geometry
 * (box size + glyph font-size) is set in Python, from theme_gallery._star_geometry
 * (a data_row_height() read off the star's own anchor widget), so it tracks
 * ui_font_scale instead of a flat pixel constant; this rule only carries the
 * chrome that the QSS pipeline owns. Color rules live further down with the
 * other themed button rules. */
QToolButton#starToggle {
    background: transparent;
    border: none;
    padding: 0;
}

/* ============== INPUT FIELD STYLES ============== */

/* Same rule as the buttons above: height is text plus padding, never a floor. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-default}px;
    border: 1px solid;
}

/* No `border-width` change on focus. Thickening the border re-runs the QSS box
   model, so the field's size hint grew by 2px the moment it was tabbed into and
   every row under it shifted down. The ring is the border *colour*, set in the
   focus block at the end of this file — colour never moves anything. */

/* Disabled inputs get their real background and text colour from the themed
   :disabled rule further down — `opacity` is inert here.
   Placeholder text is coloured there too, via `placeholder-text-color`; Qt has
   no `::placeholder` pseudo-element and no way to italicise placeholders. */

/* Spin box buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: ${spacing-md}px;
    border: none;
}

/* ============== GROUP BOX STYLES ============== */

QGroupBox {
    font-size: ${font-size-h3}px;
    font-weight: 600;
    border-radius: ${border-radius-large}px;
    border: 1px solid;
    margin-top: ${spacing-sm}px;
    padding-top: ${spacing-md}px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 ${spacing-xs}px;
    left: ${spacing-sm}px;
}

/* ============== TAB WIDGET STYLES ============== */

QTabWidget::pane {
    border: none;
    top: -1px;
}

QTabBar::tab {
    min-height: ${spacing-xl}px;
    padding: ${spacing-xs}px ${spacing-md}px;
    font-size: ${font-size-body}px;
    font-weight: 500;
    border: none;
}

QTabBar::tab:selected {
    font-weight: 600;
}

/* ============== TEXT EDIT / LOG STYLES ============== */

/* QPlainTextEdit rides along: Reading -> Text pastes into one, and without a
   declared border Qt draws its own native frame, which no theme colour and no
   focus rule can reach — so that screen's main input had no focus ring. */
QTextEdit,
QPlainTextEdit {
    border-radius: ${border-radius-default}px;
    border: 1px solid;
    padding: ${spacing-sm}px;
    font-size: ${font-size-body-sm}px;
}

/* The activity log is machine output: fixed pitch so timestamps and levels line
   up down the column. The family comes from the platform (D44-B) — 'Consolas'
   and 'JetBrains Mono' exist on one desktop each. */
QTextEdit#log-widget {
    font-family: ${font-family-mono};
}

/* The subtitle strip under the player. Frameless, and exactly two lines tall for
   the whole session (set from Python metrics) so the video never jumps when a
   cue arrives, wraps onto a second line, or ends. No font-size here: the
   Japanese content rule above owns it. */
QTextEdit#subtitle-strip {
    border: none;
    padding: ${spacing-xxs}px ${spacing-sm}px;
}

/* ============== PROGRESS BAR STYLES ============== */

QProgressBar {
    height: ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
    text-align: center;
    border: none;
}

QProgressBar::chunk {
    border-radius: ${border-radius-small}px;
}

/* ============== DATA VIEW STYLES ============== */
/* Tables, lists and trees are one surface (decision D42): same frame, same
 * cell padding, same selection. Lists used to be omitted here, so they fell
 * back to the platform's selection colour and looked nothing like the table
 * beside them. */

QTableWidget,
QListWidget,
QTreeWidget {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    gridline-color: transparent;
}

/* Vertical padding is the smallest step and horizontal is one above it: a row
   only has to separate itself from the row above, while a column has to be
   readable as a column. It must stay in step with ``qt_helpers.CELL_PADDING_Y``,
   which is what sizes the row — when the two disagree the taller one wins and
   the shorter one clips. */
QTableWidget::item,
QListWidget::item,
QTreeWidget::item {
    padding: ${spacing-xxs}px ${spacing-xs}px;
    border: none;
}

QTableWidget::item:selected,
QListWidget::item:selected,
QTreeWidget::item:selected {
    border: none;
}

QHeaderView::section {
    padding: ${spacing-xs}px;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid;
}

QHeaderView::section:vertical {
    padding: 2px 6px;
    font-weight: 500;
    min-width: 30px;
}

QHeaderView::section:horizontal {
    border-right: 1px solid;
}

QHeaderView::section:horizontal:last {
    border-right: none;
}

/* ============== SCROLL BAR STYLES ============== */

QScrollBar:vertical {
    width: ${spacing-sm}px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: ${border-radius-default}px;
    margin: 2px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    height: ${spacing-sm}px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    border-radius: ${border-radius-default}px;
    margin: 2px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* ============== DIALOG STYLES ============== */

QDialog {
    border-radius: ${border-radius-large}px;
}

QMessageBox {
    font-size: ${font-size-body}px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ============== STATUS BAR STYLES ============== */

QStatusBar {
    font-size: ${font-size-small}px;
    border-top: 1px solid;
}

QStatusBar::item {
    border: none;
}

/* ============== TOOLTIP STYLES ============== */

QToolTip {
    padding: ${spacing-xxs}px 10px;
    border-radius: ${border-radius-default}px;
    font-size: ${font-size-caption}px;
    border: 1px solid;
}

/* ============== MENU STYLES ============== */

QMenu {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    padding: ${spacing-xxs}px;
}

QMenu::item {
    padding: ${spacing-xs}px ${spacing-lg}px ${spacing-xs}px ${spacing-sm}px;
    border-radius: ${border-radius-small}px;
}

QMenu::separator {
    height: 1px;
    margin: ${spacing-xxs}px ${spacing-xs}px;
}

/* ============== COMBO BOX STYLES ============== */

QComboBox::drop-down {
    border: none;
    width: ${spacing-md}px;
}

QComboBox::down-arrow {
    width: ${spacing-sm}px;
    height: ${spacing-sm}px;
}

QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    selection-background-color: transparent;
    padding: ${spacing-xxs}px;
}

QComboBox QAbstractItemView::item {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-small}px;
}

/* ============== CHECK BOX STYLES ============== */

QCheckBox {
    spacing: ${spacing-xs}px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: ${border-radius-small}px;
    border: 2px solid;
}

/* ============== RADIO BUTTON STYLES ============== */

QRadioButton {
    spacing: ${spacing-xs}px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid;
}

/* ============== FRAME STYLES ============== */

QFrame#card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: 0;
}

QFrame#divider {
    max-height: 1px;
    border: none;
}

/* ============== CUSTOM WIDGET HELPERS ============== */

/* Pinned workflow action bar (D6). It sits outside the page scroll, so the rule
   above it is what tells the eye the page ended -- not a card border, because
   the bar is not a card and must not read as more content. */
QWidget#workflow-action-bar {
    border-top: 1px solid;
}

/* Thin enough to be a rule under the page rather than a gauge; the counts and
   the clock are text beside it. `max-height` as well as `height`, or Qt lets
   the bar grow back to its style's own minimum in several themes. */
QProgressBar#workflow-progress {
    height: ${spacing-xxs}px;
    max-height: ${spacing-xxs}px;
    border: none;
    border-radius: 0;
}

/* Log widget header */
QWidget#log-header {
    border-top-left-radius: ${border-radius-default}px;
    border-top-right-radius: ${border-radius-default}px;
    padding: ${spacing-xs}px ${spacing-sm}px;
}

/* Progress stats — the running clock. Fixed pitch from the platform so the
   digits do not shuffle sideways once a second (D44-B). */
QLabel#progress-stats {
    font-size: ${font-size-body-sm}px;
    padding: 2px 0;
    font-family: ${font-family-mono};
}

/* Status badge */
QLabel#status-badge {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 600;
}

/* Section header */
QLabel#section-header {
    font-size: ${font-size-h3}px;
    font-weight: 600;
    padding: ${spacing-xs}px 0;
}

/* Stat card */
QFrame#stat-card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: ${spacing-md}px;
}

QLabel#stat-value {
    font-size: ${font-size-stat-value}px;
    font-weight: 700;
}

QLabel#stat-label {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Validation badge */
QLabel#validation-badge {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 500;
}

/* Header widget */
QWidget#header-widget {
    border-bottom: 1px solid;
}

/* Screen issue banner (D24): one persistent surface for recoverable problems.
   Reuses the warning badge endpoints so no theme gains a key: an issue here is
   by definition survivable, and the error red stays reserved for destruction. */
QFrame#screen-issue-banner {
    background-color: ${color-badge-warning-bg};
    border: 1px solid ${color-warning};
    border-radius: ${border-radius-default}px;
}

QFrame#screen-issue-banner QLabel#screen-issue-summary {
    color: ${color-badge-warning-text};
    font-size: ${font-size-body-sm}px;
}

QFrame#screen-issue-banner QLabel#screen-issue-details {
    color: ${color-badge-warning-text};
    font-size: ${font-size-caption}px;
}

/* Update banner */
QFrame#update-banner {
    border-radius: ${border-radius-default}px;
    margin: ${spacing-xxs}px ${spacing-xs}px;
    padding: ${spacing-xxs}px ${spacing-xs}px;
}

QFrame#update-banner QLabel {
    font-size: ${font-size-body-sm}px;
}

QFrame#update-banner QPushButton {
    border: 1px solid;
    border-radius: ${border-radius-small}px;
    padding: 2px 10px;
    font-size: ${font-size-caption}px;
}

QFrame#update-banner QPushButton:hover {
    border: 1px solid;
}

QFrame#update-banner QPushButton#dismissBtn {
    border: none;
    font-size: ${font-size-body}px;
    font-weight: bold;
    padding: 2px 6px;
}

/* Status bar styles */
QWidget#status-bar {
    font-size: ${font-size-body-sm}px;
    border-radius: ${border-radius-default}px;
}

QLabel#status-operation {
    font-size: ${font-size-body-sm}px;
    font-weight: 500;
}

QLabel#status-stats {
    font-size: ${font-size-caption}px;
}

QLabel#settings-save-status {
    color: ${color-success};
    font-weight: 500;
}

QLabel#status-indicator {
    padding: ${spacing-xxs}px ${spacing-xs}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 500;
}

QFrame#status-separator {
    max-width: 1px;
}

/* Queue item card */
QFrame#queue-item-card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: 0;
    margin: ${spacing-xxs}px 0;
}

QFrame#queue-item-card:hover {
    border-width: 2px;
}

QLabel#queue-item-title {
    font-size: ${font-size-h3}px;
    font-weight: 700;
}

QLabel#queue-item-path {
    font-size: ${font-size-caption}px;
    padding: 2px ${spacing-xxs}px;
    border-radius: ${border-radius-small}px;
}

QLabel#queue-item-stats {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    padding: 2px ${spacing-xxs}px;
    border-radius: ${border-radius-small}px;
}

/* Queue stats label - summary statistics */
QLabel#queue-stats {
    font-size: ${font-size-body-sm}px;
    font-weight: 500;
    padding: ${spacing-xxs}px 10px;
    border-radius: ${border-radius-default}px;
}

QLabel#queue-status-badge {
    padding: ${spacing-xxs}px 10px;
    border-radius: 10px;
    font-size: ${font-size-small}px;
    font-weight: 600;
    text-transform: uppercase;
}

QProgressBar#queue-progress {
    border: none;
    border-radius: 2px;
}

/* ============== SETTINGS TAB STYLES ============== */

/* Grouped settings navigator (D10). Group headings are inert rows: Qt paints
   them through the disabled state, which the colour rules below pick up.

   The 1px border is reserved transparent rather than absent: it is the keyboard
   focus ring, recoloured in the focus block at the end of this file. Declared
   here so focus recolours a box that is drawn either way and the rail cannot
   shift 1px under the cursor. */
QListWidget#settings-nav {
    border: 1px solid transparent;
    outline: none;
}

/* The left border is the selected-destination marker, reserved transparent on
   every row for the same reason. Both headings and destinations reserve it, so
   the deliberate heading outdent below is unchanged. */
QListWidget#settings-nav::item {
    padding: ${spacing-xs}px ${spacing-sm}px ${spacing-xs}px ${spacing-md}px;
    border: none;
    border-left: 2px solid transparent;
}

/* Headings are the disabled rows, and they outdent under their destinations. */
QListWidget#settings-nav::item:disabled {
    padding-left: ${spacing-xs}px;
}

/* Validation status labels */
QLabel#validation-status {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    padding: ${spacing-xxs}px 0;
}

/* Helper/hint text. Dimming comes from the themed `color: ${color-text-muted}`
   rule further down; `opacity` was inert. */
QLabel#helper-text {
    font-size: ${font-size-small}px;
    font-style: italic;
    padding: 2px ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
    margin-top: ${spacing-xxs}px;
}

/* A diagnostic belonging to one row of a list, printed under that row's label.
   Helper text in every respect except padding: its left edge is set by the
   layout that knows how wide the columns above it came out, so padding here
   would fight that and leave the line 8px off its own label. */
QLabel#row-detail {
    font-size: ${font-size-small}px;
    font-style: italic;
    margin-top: ${spacing-xxs}px;
}

/* Output-location value: small muted helper styling but NOT italic */
QLabel#output-location-value {
    font-size: ${font-size-small}px;
    padding: 2px ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
    margin-top: ${spacing-xxs}px;
}

/* Read-only command display (copyable shell command in setup guidance) */
QLineEdit#command-text {
    font-family: ${font-family-mono};
}

/* ============== THEME COLOR RULES ============== */
/* All colors use ${color-*} variables from the active JSON theme file. */

/* --- Base Colors --- */

QWidget {
    color: ${color-text};
}

QMainWindow {
    background-color: ${color-background};
}

QScrollArea {
    background-color: ${color-background};
}

QScrollArea > QWidget {
    background-color: ${color-background};
}

/* System Health's row list. The two rules above paint any scroll area in
   `background`, which inside a dialog painted in `surface` reads as an
   unrounded inset slab in the wrong colour -- plainly so in dark mode. This
   screen is one surface, so its scroller, viewport, list and rows all defer to
   the dialog behind them. Id selectors, so they outrank the rules above
   whatever the order. */
QScrollArea#health-scroll,
QWidget#health-scroll-viewport,
QWidget#health-list,
QFrame#health-row {
    background-color: transparent;
}

/* --- Buttons ---
   D41: accent is scarce. A button is quiet unless it is the one task action on
   its screen, whatever Qt has made the dialog default, a checked toggle, or the
   solid-red destruction of something unrecoverable. Ordering below matters: Qt
   follows CSS2.1 specificity, so an id selector outranks a bare state and the
   state rules that must win are spelled out per id. */

QPushButton {
    background-color: transparent;
    color: ${color-text};
    border-color: ${color-border};
}

QPushButton:hover {
    background-color: ${color-surface-hover};
}

QPushButton:pressed {
    background-color: ${color-surface-alt};
}

/* Ghost gives up its border too: a control that should barely be there. */
QPushButton#ghost {
    background-color: transparent;
    color: ${color-text};
    border-color: transparent;
}

QPushButton#ghost:hover {
    background-color: ${color-surface-hover};
}

/* `danger` is an outline. A removal you can redo does not need to shout. */
QPushButton#danger {
    background-color: transparent;
    color: ${color-error};
    border-color: ${color-error};
}

QPushButton#danger:hover {
    background-color: ${color-surface-hover};
    color: ${color-error-hover};
    border-color: ${color-error-hover};
}

/* `critical` is the only solid red in the app. Two call sites. */
QPushButton#critical {
    background-color: ${color-error};
    color: ${color-text-on-primary};
    border-color: ${color-error};
}

QPushButton#critical:hover {
    background-color: ${color-error-hover};
    border-color: ${color-error-hover};
}

/* The accent fill. `:default` is here so a dialog's Enter target keeps its
   visual weight whatever variant the call site asked for. */
QPushButton#primary,
QPushButton:default {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton#ghost:default,
QPushButton#danger:default {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton#primary:hover,
QPushButton:default:hover {
    background-color: ${color-primary-hover};
}

QPushButton#primary:pressed,
QPushButton:default:pressed {
    background-color: ${color-primary-pressed};
}

/* ModernButton answers a press with an animated tint it paints itself (see
   gui/widgets/enhanced/modern_button.py — QSS has no transition property), so
   the instant swaps above are put back to whatever the button was already
   showing: one press, one answer. Plain QPushButtons keep their swap.

   Two swaps reach this class under D41 and each gets a rule here: the base
   one, which is now the quiet control and so covers #secondary and every
   unmarked button, and the accent one on #primary and Qt's dialog default.
   #ghost, #danger and #critical need nothing — their id selectors already
   outrank `QPushButton:pressed` and they never saw it.

   The bare `:pressed` rules carry the *same* specificity as the rules they
   cancel, so their position in the sheet is what makes them win: a subclass
   type selector is not stronger than its base, only later. That pins this
   block between the swaps above and the `:checked` rules below — move it down
   past `:checked` and a held toggle loses its accent for as long as the finger
   is down. The `:hover` halves outrank their targets outright and are here
   because a mouse press is also a hover: dropping the hover colour for the
   duration of the press would be a second answer of its own. */
ModernButton:pressed {
    background-color: transparent;
}

ModernButton:hover:pressed {
    background-color: ${color-surface-hover};
}

ModernButton#primary:pressed,
ModernButton:default:pressed {
    background-color: ${color-primary};
}

ModernButton#primary:hover:pressed,
ModernButton:default:hover:pressed {
    background-color: ${color-primary-hover};
}

/* A checked toggle is state, and state is the other thing accent is for. */
QPushButton:checked,
QPushButton#ghost:checked {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton:checked:hover,
QPushButton#ghost:checked:hover {
    background-color: ${color-primary-hover};
}

/* Unavailable reads the same in every role. */
QPushButton:disabled,
QPushButton#primary:disabled,
QPushButton#secondary:disabled,
QPushButton#ghost:disabled,
QPushButton#danger:disabled,
QPushButton#critical:disabled {
    background-color: ${color-disabled};
    color: ${color-text-on-primary};
    border-color: ${color-disabled};
}

/* Focus is the last word on the border, so it outlives every role above.
   `border-focus` equals `primary` in 26 of the 29 shipped themes, so on a
   filled button the ring is drawn in the colour that sits ON the fill.

   `[keyboardFocus="true"]` is what keeps a click from ringing the button it
   pressed — see the focus block at the end of this file. */
QPushButton:focus[keyboardFocus="true"],
QPushButton#secondary:focus[keyboardFocus="true"],
QPushButton#ghost:focus[keyboardFocus="true"],
QPushButton#danger:focus[keyboardFocus="true"] {
    border-color: ${color-border-focus};
}

QPushButton#primary:focus[keyboardFocus="true"],
QPushButton#critical:focus[keyboardFocus="true"],
QPushButton:default:focus[keyboardFocus="true"],
QPushButton:checked:focus[keyboardFocus="true"] {
    border-color: ${color-text-on-primary};
}

QToolButton#starToggle {
    color: ${color-text-muted};
}

QToolButton#starToggle:hover {
    color: ${color-text};
}

QToolButton#starToggle:checked {
    color: ${color-warning};
}

/* --- Input Fields --- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: ${color-input-bg};
    color: ${color-text};
    border-color: ${color-border};
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: ${color-border-focus};
    background-color: ${color-input-bg};
}

/* The header's two selectors are chrome, not a form, and they are the FIRST
   focusable widgets in the window — so Qt's focus wrap-around parks focus on
   them whenever something elsewhere hides, disables or destroys the widget that
   had it. A settings click therefore lit an accent box in the top-right corner.
   The panels no longer throw focus (see `_keep_focus_in_list` in
   `panels/chain_settings_panel_base.py`); this rule is what makes the corner
   quiet whatever else does it next.

   Unconditional, not `[keyboardFocus="true"]`-gated like the ring at the end of
   this file: the wrap-around arrives through `focusNextChild()`, which focuses
   with `TabFocusReason`, so the keyboard gate is true on exactly the path this
   suppresses. Neither combo takes typing, so no border has to say where it goes;
   both stay StrongFocus and fully keyboard-operable. */
QComboBox#theme-combo:focus,
QComboBox#profile-combo:focus {
    border-color: ${color-border};
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: ${color-input-disabled-bg};
    color: ${color-text-disabled};
}

/* Qt has no `::placeholder` pseudo-element; `placeholder-text-color` on the
   widget itself is the supported spelling (it writes QPalette::PlaceholderText). */
QLineEdit {
    placeholder-text-color: ${color-text-muted};
}

/* --- Group Boxes --- */

QGroupBox {
    color: ${color-text};
    background-color: ${color-surface};
    border-color: ${color-border};
}

QGroupBox::title {
    color: ${color-text};
}

/* --- Tabs --- */

QTabWidget::pane {
    background-color: ${color-background};
    border: none;
}

QTabBar::tab {
    color: ${color-text-muted};
    background-color: transparent;
}

QTabBar::tab:hover {
    color: ${color-text};
    background-color: ${color-surface-hover};
}

/* The underline is the navigation indicator and keeps the accent; the label
   goes back to ordinary text, so the accent means "you are here" exactly once. */
QTabBar::tab:selected {
    color: ${color-text};
    background-color: transparent;
    border-bottom: 3px solid ${color-primary};
}

/* AnimatedTabBar draws that same 3px indicator itself so it can slide between
 * tabs (gui/widgets/base/animated_tab_bar.py -- QSS has no transition
 * property). The border stays, so tab heights do not change; only its colour
 * goes, and the accent is handed to the painter here rather than looked up
 * from Python. Plain QTabBars keep the static indicator. */
AnimatedTabBar {
    qproperty-accentColour: ${color-primary};
}

AnimatedTabBar::tab:selected {
    border-bottom-color: transparent;
}

/* --- Text Edit / Log --- */

QTextEdit,
QPlainTextEdit {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QTextEdit#log-widget {
    background-color: ${color-surface};
}

/* --- Progress Bar --- */

QProgressBar {
    background-color: ${color-border};
    color: ${color-text};
}

QProgressBar::chunk {
    background-color: ${color-primary};
}

/* --- Data views: tables, lists and trees --- */
/* One selection and one hover, whichever kind of view the pointer is over. */

QTableWidget,
QListWidget,
QTreeWidget {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QTableWidget::item:hover,
QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: ${color-surface-hover};
}

QTableWidget::item:selected,
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QTableWidget::item:alternate,
QListWidget::item:alternate,
QTreeWidget::item:alternate {
    background-color: ${color-surface-alt};
    color: ${color-text};
}

QTableWidget::item:alternate:hover,
QListWidget::item:alternate:hover,
QTreeWidget::item:alternate:hover {
    background-color: ${color-surface-hover};
}

QTableWidget::item:alternate:selected,
QListWidget::item:alternate:selected,
QTreeWidget::item:alternate:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QHeaderView::section {
    background-color: ${color-background};
    color: ${color-text};
    border-color: ${color-border};
}

QHeaderView::section:vertical {
    background-color: ${color-background};
    color: ${color-text};
    border-color: ${color-border};
}

QTableCornerButton::section {
    background-color: ${color-background};
    border: 1px solid ${color-border};
}

/* --- Scroll Bars --- */

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: transparent;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: ${color-scrollbar};
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: ${color-scrollbar-hover};
}

/* --- Status Bar --- */

QStatusBar {
    background-color: ${color-surface};
    color: ${color-text-muted};
    border-color: ${color-border};
}

/* --- Tooltips --- */

QToolTip {
    background-color: ${color-tooltip-bg};
    color: ${color-tooltip-text};
    border-color: ${color-tooltip-border};
}

/* The subtitle strip reads like a tooltip over the video and borrows its keys,
   so it follows all 29 themes. It used to hardcode rgba(0,0,0,180) on white,
   which ignored every one of them. */
QTextEdit#subtitle-strip {
    background-color: ${color-tooltip-bg};
    color: ${color-tooltip-text};
}

/* --- Menus --- */

QMenu {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QMenu::item:selected {
    background-color: ${color-surface-hover};
    color: ${color-text};
}

QMenu::separator {
    background-color: ${color-border};
}

/* --- Menu bar (top strip + Report/Star/Discord corner buttons) ---
   Without an explicit QMenuBar rule, Qt stops native-styling the menu bar once
   an app-wide stylesheet is applied but does NOT fall back to the palette
   Window color, so on Windows the strip stays white while QWidget{color} paints
   the text near-white -> white-on-white in dark themes. Theme it from tokens. */
QMenuBar {
    background-color: ${color-background};
    color: ${color-text};
}

QMenuBar::item {
    background: transparent;
    color: ${color-text};
    padding: ${spacing-xs}px ${spacing-sm}px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: ${color-surface-hover};
    color: ${color-text};
}

/* The menu-bar corner container (Report/Star/Discord). Named so its background
   paints uniformly on Windows instead of relying on the transparent child
   showing the QMenuBar fill through. */
QWidget#menu_corner_widget {
    background-color: ${color-background};
}

/* Corner link buttons are autoRaise QToolButtons (transparent bg, no inline
   style); theme their text so they stay readable in dark mode. */
QToolButton#report_issue_button,
QToolButton#github_star_button,
QToolButton#discord_button {
    color: ${color-text};
    background-color: transparent;
    padding: ${spacing-xxs}px ${spacing-xs}px;
}

QToolButton#report_issue_button:hover,
QToolButton#github_star_button:hover,
QToolButton#discord_button:hover {
    color: ${color-text};
    background-color: ${color-surface-hover};
}

/* --- Combo Box Dropdown --- */

QComboBox QAbstractItemView {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QComboBox QAbstractItemView::item:hover {
    background-color: ${color-surface-hover};
}

QComboBox QAbstractItemView::item:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

/* --- Check Boxes & Radio Buttons --- */

QCheckBox, QRadioButton {
    color: ${color-text};
}

QCheckBox::indicator, QRadioButton::indicator {
    background-color: ${color-input-bg};
    border-color: ${color-border-subtle};
}

/* Hovering an unchecked box is not a state change; only checking it is. */
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: ${color-border};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: ${color-primary};
    border-color: ${color-primary};
}

/* --- Dialogs --- */

QDialog {
    background-color: ${color-surface};
    color: ${color-text};
}

QMessageBox {
    background-color: ${color-surface};
}

/* --- Custom Widgets --- */

/* Pinned action bar: the page's own surface, separated by one divider line. */
QWidget#workflow-action-bar {
    background-color: ${color-surface};
    border-color: ${color-divider};
}

QProgressBar#workflow-progress {
    background-color: transparent;
}

/* Log header */
QWidget#log-header {
    background-color: ${color-surface-alt};
    border-bottom: 1px solid ${color-border};
}

/* Status badges */
QLabel#status-badge {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
    border-color: ${color-border-subtle};
}

QLabel#status-badge[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
    border-color: ${color-success};
}

QLabel#status-badge[status="warning"] {
    background-color: ${color-badge-warning-bg};
    color: ${color-badge-warning-text};
}

QLabel#status-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
    border-color: ${color-error};
}

QLabel#status-badge[status="info"],
QLabel#status-badge[status="checking"] {
    background-color: ${color-badge-info-bg};
    color: ${color-badge-info-text};
    border-color: ${color-info};
}

QLabel#status-badge[status="pending"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
}

/* Stat cards */
QFrame#stat-card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* A statistic is information, not an action: it reads as text. */
QLabel#stat-value {
    color: ${color-text};
}

QLabel#stat-label {
    color: ${color-text-muted};
}

/* Section headers */
QLabel#section-header {
    color: ${color-text};
}

/* Frames and cards */
QFrame#card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

QFrame#divider {
    background-color: ${color-divider};
}

/* Progress stats */
QLabel#progress-stats {
    color: ${color-text-muted};
}

/* --- Special States --- */

QLineEdit[error="true"] {
    border-color: ${color-error};
    border-width: 2px;
}

QLineEdit[success="true"] {
    border-color: ${color-success};
    border-width: 2px;
}

QLineEdit[warning="true"] {
    border-color: ${color-warning};
    border-width: 2px;
}

/* Drop targets while a drag is in the air (D50). Set by FileSelector on drag
   enter and cleared on leave/drop, so a valid target says "Drop Video File
   here" instead of leaving the user to guess whether releasing will do
   anything. Placed AFTER the error/success rules on purpose: the three have
   equal specificity, so load order decides, and what the drag will do now
   outranks what the field held a moment ago.

   `border-focus`, not `primary`: a lit drop target says "the interaction is
   pointed HERE", which is what the focus border already means, and D41-B keeps
   the accent itself scarce — one primary action, navigation, focus, checked
   controls, progress. A drop target is none of those. */
QLineEdit[dropState="valid"] {
    border-color: ${color-border-focus};
    border-width: 2px;
}

QLineEdit[dropState="invalid"] {
    border-color: ${color-error};
    border-width: 2px;
}

/* The control a settings search jumped to, for the moment after it lands.
   A tint rather than a border: a border would change the control's size hint
   and shift the whole form for as long as the mark is up. The selection colour
   pair is the one every theme already tunes to mean "this is the one you
   picked", so no new theme key is introduced.

   The `:focus` copy is load-bearing, not redundant. A jump focuses its target,
   and `QLineEdit:focus, QSpinBox:focus, …` above already sets a background;
   that selector outranks a bare attribute selector, so without this the mark
   silently loses on every control that can hold focus — which is all of them. */
*[settingsSearchHit="true"],
*[settingsSearchHit="true"]:focus {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
    border-radius: ${border-radius-default}px;
}

/* --- Validation Badges --- */

QLabel#validation-badge {
    border: 1px solid ${color-border};
}

QLabel#validation-badge[status="checking"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
    border-color: ${color-border};
}

QLabel#validation-badge[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
    border-color: ${color-success};
}

QLabel#validation-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
    border-color: ${color-error};
}

QLabel#validation-badge[status="warning"] {
    background-color: ${color-badge-warning-bg};
    color: ${color-badge-warning-text};
    border-color: ${color-warning};
}

/* --- Header Widget --- */

QWidget#header-widget {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* --- Update Banner --- */

QFrame#update-banner {
    background-color: ${color-update-banner-bg};
}

QFrame#update-banner QLabel {
    color: ${color-update-banner-text};
}

/* The banner paints its own two colours, so its buttons invert between them
   rather than reaching for a translucent white that only worked on one theme. */
QFrame#update-banner QPushButton {
    background-color: transparent;
    color: ${color-update-banner-text};
    border-color: ${color-update-banner-text};
}

QFrame#update-banner QPushButton:hover {
    background-color: ${color-update-banner-text};
    color: ${color-update-banner-bg};
}

/* --- Status Bar Widget --- */

QWidget#status-bar {
    background-color: ${color-surface};
    border-top: 1px solid ${color-border};
}

QLabel#status-operation[level="info"] {
    color: ${color-info};
}

QLabel#status-operation[level="success"] {
    color: ${color-success};
}

QLabel#status-operation[level="warning"] {
    color: ${color-warning};
}

QLabel#status-operation[level="error"] {
    color: ${color-error};
}

QLabel#status-stats {
    color: ${color-text-muted};
}

QLabel#status-indicator[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
}

QLabel#status-indicator[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
}

QFrame#status-separator {
    background-color: ${color-border};
}

/* --- Queue Item Card --- */

QFrame#queue-item-card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* Pointing at a row is not selecting it: the hover surface says enough. */
QFrame#queue-item-card:hover {
    border-color: ${color-border};
    background-color: ${color-surface-hover};
}

QLabel#queue-item-title {
    color: ${color-text};
}

QLabel#queue-item-path {
    color: ${color-text-muted};
}

/* Entry counts are metadata about a row, not a call to act on it. */
QLabel#queue-item-stats {
    color: ${color-text-muted};
}

QLabel#queue-stats {
    background-color: ${color-surface-alt};
    color: ${color-text};
}

QLabel#queue-status-badge[status="pending"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
}

QLabel#queue-status-badge[status="processing"] {
    background-color: ${color-badge-info-bg};
    color: ${color-badge-info-text};
}

QLabel#queue-status-badge[status="complete"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
}

QLabel#queue-status-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
}

/* --- Settings Tab --- */

QListWidget#settings-nav {
    background-color: transparent;
}

QListWidget#settings-nav::item:disabled {
    color: ${color-text-muted};
}

QListWidget#settings-nav::item:hover {
    background-color: ${color-surface-hover};
}

/* The bar on the left edge says which destination is open. It rides the border
   the structural rule already reserved, so selecting a row recolours a box
   rather than adding one and nothing shifts. */
QListWidget#settings-nav::item:selected {
    color: ${color-primary};
    background-color: ${color-surface-hover};
    border-left-color: ${color-border-focus};
}

QLabel#validation-status[status="success"] {
    color: ${color-success};
}

QLabel#validation-status[status="error"] {
    color: ${color-error};
}

QLabel#validation-status[status="checking"] {
    color: ${color-info};
}

QLabel#helper-text,
QLabel#row-detail {
    color: ${color-text-muted};
}

QLabel#output-location-value {
    color: ${color-text-muted};
}

/* Chain priority rows (D13). Each row states its own facts on its own second
   line, so the metadata carries the muted role and only real breakage spends
   the warning colour. Replaces the inline `gray` / `#d97706` stylesheets the
   four chain panels each wrote by hand, which no theme could reach. */
QLabel#chain-row-meta,
QLabel#row-meta,
QLabel#dialog-subtitle {
    color: ${color-text-muted};
}

QLabel#chain-row-warning {
    color: ${color-warning};
}

/* --- Sakura-specific: Decorative elements --- */

QLabel#decorative {
    color: ${color-decorative};
}

/* ============== KEYBOARD FOCUS RING (D48-B, D41) ==============
   BEGIN focus ring — self-contained; nothing outside this block belongs to it.

   Under D41 the accent is scarce and reserved for four things, and keyboard
   focus is one of them, so the ring is an accent ring in all 29 themes. Buttons
   and text inputs get theirs from the role rules above; what is left here is
   every control that had none.

   Three rules held throughout:

   * **Colour only, or `outline`.** Both leave the control's box exactly as
     `widgets/base/sizing.py` measured it. A border that appears or thickens on
     focus does not — it re-runs the box model and the form reflows under the
     cursor.
   * **`outline` only where Qt honours it.** Qt paints a stylesheet outline on
     QPushButton and on item views and silently ignores it on QLineEdit,
     QComboBox and friends, so it is used only where it actually draws.
   * **Keyboard focus only, on panes and buttons.** `:focus` alone was the bug
     this block once shipped: Qt's `:focus` is true however focus arrived, so
     clicking a curator pane painted a 600-pixel accent box around it. The ring
     that a keyboard needs is noise when a mouse put it there.
     `gui/utils/focus_ring.py` marks the focused widget `keyboardFocus` when the
     `QFocusEvent` reason is a keystroke, and these rules ask for both states —
     Qt's own `:focus-visible`, which Qt does not have. Keeping `:focus` in the
     selector is deliberate: a mark that outlived its focus then draws nothing.

     Text inputs and checkable indicators are exempt, on purpose. An accent
     border on a field says where typing goes, and that is worth a click.

   Last in the file on purpose: these selectors tie with the role rules above,
   and load order is what makes focus the final word on the ring. */

/* Checkable controls. The indicator already reserves a 2px border, so this is a
   recolour of a box that is drawn either way. `::indicator:focus` — subcontrol
   then state — is the spelling Qt honours; `:focus::indicator` parses and does
   nothing. */
QCheckBox::indicator:focus,
QRadioButton::indicator:focus {
    border-color: ${color-border-focus};
}

/* Text areas and item views all reserve `border: 1px solid` in the structural
   rules above, so the ring is that border restated in the accent. These are the
   panes a mouse click used to box: the curator's word list and sentence list,
   every log and preview. */
QTextEdit:focus[keyboardFocus="true"],
QPlainTextEdit:focus[keyboardFocus="true"],
QTableWidget:focus[keyboardFocus="true"],
QListWidget:focus[keyboardFocus="true"],
QTreeWidget:focus[keyboardFocus="true"] {
    border-color: ${color-border-focus};
}

/* The settings navigator was the one item view drawn without a frame, and this
   rule used to spell its ring `outline: 2px solid`, on the understanding that
   Qt would draw that around the viewport. It does not. Qt renders a stylesheet
   `outline` on an item view as the *current item's* focus rect, so what shipped
   was a 2px accent box hugging the text of whichever destination was open —
   drawn on a mouse click, because clicking is what gives the list focus.

   The ring is now the 1px border the structural rule reserves, restated in the
   accent like every other item view above, and drawn only for a keyboard. That
   click still boxed the navigator itself until the ring went keyboard-only; the
   left bar on the selected row is what says which destination is open. The
   `outline: none` further up stays and does the job its own comment claims:
   suppressing the per-item rect. */
QListWidget#settings-nav:focus[keyboardFocus="true"] {
    border-color: ${color-border-focus};
}

/* END focus ring */
