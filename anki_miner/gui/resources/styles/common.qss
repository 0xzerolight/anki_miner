/*
 * Common Base Styles for Anki Miner
 * Shared styles that apply across all themes
 *
 * Variables from _variables.py are substituted at load time:
 * - ${font-size-*}: h1, h2, h3, body, body-sm, caption, small, stat-value, icon-large
 * - ${spacing-*}: xxs, xs, sm, md, lg, xl
 * - ${border-radius-*}: small, default, large
 */

/* ============== BASE WIDGET STYLES ============== */

QWidget {
    font-family: 'Segoe UI', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: ${font-size-body}px;
    font-weight: 400;
}


QMainWindow {
    font-size: ${font-size-body}px;
}

/* ============== TYPOGRAPHY HELPERS ============== */

QLabel#heading1 {
    font-size: ${font-size-h1}px;
    font-weight: 700;
}

QLabel#heading2 {
    font-size: ${font-size-h2}px;
    font-weight: 600;
}

QLabel#heading3 {
    font-size: ${font-size-h3}px;
    font-weight: 600;
}

QLabel#caption {
    font-size: ${font-size-caption}px;
    padding: 4px ${spacing-xs}px;
    min-height: 20px;
    border-radius: ${border-radius-small}px;
}

QLabel#small {
    font-size: ${font-size-small}px;
    padding: 2px 0;
    min-height: 16px;
}

QLabel#field-label {
    padding: 4px ${spacing-xs}px;
    min-height: 22px;
    border-radius: ${border-radius-small}px;
}

/* Japanese text support */
*[japanese="true"] {
    font-family: 'Noto Sans JP', 'Yu Gothic', 'Meiryo', sans-serif;
}

/* ============== BUTTON BASE STYLES ============== */

/* Every button carries the same 1px box in every role. Only its colour changes,
   so keyboard focus can recolour the border without resizing anything — tabbing
   along a row of buttons must not reflow the row. */
QPushButton {
    min-height: 28px;
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-default}px;
    font-weight: 500;
    border: 1px solid;
}

/* Disabled buttons are dimmed by the themed QPushButton:disabled colour rule
   further down, not here: Qt's widget style engine ignores `opacity`. */

/* Qt's own focus rect lands inside the rounded box and reads as noise. The
   focus ring is the border recolour in the theme rules below. */
QPushButton:focus {
    outline: none;
}

/* Button variants (D41). `secondary` deliberately has no rules of its own: the
   quiet bordered control IS the base button, so the object name is only how a
   call site says out loud that it meant the ordinary one. */
QPushButton#primary,
QPushButton#danger,
QPushButton#critical {
    font-weight: 600;
}

/* Icon buttons */
QPushButton#iconButton {
    min-width: ${spacing-xl}px;
    min-height: ${spacing-xl}px;
    max-width: ${spacing-xl}px;
    max-height: ${spacing-xl}px;
    padding: ${spacing-xxs}px;
    border-radius: ${border-radius-default}px;
}

/* Themes panel: star toggle in the favorites column. Geometry (size + font)
 * is set in Python so it tracks the row-height constant; this rule only
 * carries the chrome that the QSS pipeline owns. Color rules live further
 * down with the other themed button rules. */
QToolButton#starToggle {
    background: transparent;
    border: none;
    padding: 0;
}

/* ============== INPUT FIELD STYLES ============== */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    min-height: 28px;
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-default}px;
    border: 1px solid;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-width: 2px;
}

/* Disabled inputs get their real background and text colour from the themed
   :disabled rule further down — `opacity` is inert here.
   Placeholder text is coloured there too, via `placeholder-text-color`; Qt has
   no `::placeholder` pseudo-element and no way to italicise placeholders. */

/* Spin box buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: ${spacing-md}px;
    border: none;
}

/* ============== GROUP BOX STYLES ============== */

QGroupBox {
    font-size: ${font-size-h3}px;
    font-weight: 600;
    border-radius: ${border-radius-large}px;
    border: 1px solid;
    margin-top: ${spacing-sm}px;
    padding-top: ${spacing-md}px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 ${spacing-xs}px;
    left: ${spacing-sm}px;
}

/* ============== TAB WIDGET STYLES ============== */

QTabWidget::pane {
    border: none;
    top: -1px;
}

QTabBar::tab {
    min-height: ${spacing-xl}px;
    padding: ${spacing-xs}px ${spacing-md}px;
    font-size: ${font-size-body}px;
    font-weight: 500;
    border: none;
}

QTabBar::tab:selected {
    font-weight: 600;
}

/* ============== TEXT EDIT / LOG STYLES ============== */

QTextEdit {
    border-radius: ${border-radius-default}px;
    border: 1px solid;
    padding: ${spacing-sm}px;
    font-family: 'JetBrains Mono', 'Consolas', 'SF Mono', monospace;
    font-size: ${font-size-body-sm}px;
}

QTextEdit#log-widget {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
}

/* ============== PROGRESS BAR STYLES ============== */

QProgressBar {
    height: ${spacing-xs}px;
    border-radius: ${border-radius-small}px;
    text-align: center;
    border: none;
}

QProgressBar::chunk {
    border-radius: ${border-radius-small}px;
}

/* ============== TABLE WIDGET STYLES ============== */

QTableWidget {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    gridline-color: transparent;
    selection-background-color: transparent;
}

QTableWidget::item {
    padding: ${spacing-xs}px;
    min-height: 24px;
    border: none;
}

QTableWidget::item:selected {
    border: none;
}

/* Themes panel: the star column needs the full row height for its
 * auto-sized icon button. The global 8-px item padding clips the top of
 * the glyph; scope an override to just this table so other tables in the
 * app keep their comfortable cell padding. */
QTreeWidget#themesPanelTree::item {
    padding: 0px;
}

QHeaderView::section {
    padding: 10px;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid;
}

QHeaderView::section:vertical {
    padding: 2px 6px;
    font-weight: 500;
    min-width: 30px;
}

QHeaderView::section:horizontal {
    border-right: 1px solid;
}

QHeaderView::section:horizontal:last {
    border-right: none;
}

/* ============== SCROLL BAR STYLES ============== */

QScrollBar:vertical {
    width: ${spacing-sm}px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: ${border-radius-default}px;
    margin: 2px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    height: ${spacing-sm}px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    border-radius: ${border-radius-default}px;
    margin: 2px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* ============== DIALOG STYLES ============== */

QDialog {
    border-radius: ${border-radius-large}px;
}

QMessageBox {
    font-size: ${font-size-body}px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ============== STATUS BAR STYLES ============== */

QStatusBar {
    font-size: ${font-size-small}px;
    border-top: 1px solid;
}

QStatusBar::item {
    border: none;
}

/* ============== TOOLTIP STYLES ============== */

QToolTip {
    padding: ${spacing-xxs}px 10px;
    border-radius: ${border-radius-default}px;
    font-size: ${font-size-caption}px;
    border: 1px solid;
}

/* ============== MENU STYLES ============== */

QMenu {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    padding: ${spacing-xxs}px;
}

QMenu::item {
    padding: ${spacing-xs}px ${spacing-lg}px ${spacing-xs}px ${spacing-sm}px;
    border-radius: ${border-radius-small}px;
}

QMenu::separator {
    height: 1px;
    margin: ${spacing-xxs}px ${spacing-xs}px;
}

/* ============== COMBO BOX STYLES ============== */

QComboBox::drop-down {
    border: none;
    width: ${spacing-md}px;
}

QComboBox::down-arrow {
    width: ${spacing-sm}px;
    height: ${spacing-sm}px;
}

QComboBox QAbstractItemView {
    border: 1px solid;
    border-radius: ${border-radius-default}px;
    selection-background-color: transparent;
    padding: ${spacing-xxs}px;
}

QComboBox QAbstractItemView::item {
    min-height: ${spacing-xl}px;
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: ${border-radius-small}px;
}

/* ============== CHECK BOX STYLES ============== */

QCheckBox {
    spacing: ${spacing-xs}px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: ${border-radius-small}px;
    border: 2px solid;
}

/* ============== RADIO BUTTON STYLES ============== */

QRadioButton {
    spacing: ${spacing-xs}px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid;
}

/* ============== FRAME STYLES ============== */

QFrame#card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: 0;
}

QFrame#divider {
    max-height: 1px;
    border: none;
}

/* ============== CUSTOM WIDGET HELPERS ============== */

/* Log widget header */
QWidget#log-header {
    border-top-left-radius: ${border-radius-default}px;
    border-top-right-radius: ${border-radius-default}px;
    padding: ${spacing-xs}px ${spacing-sm}px;
}

/* Progress stats */
QLabel#progress-stats {
    font-size: ${font-size-body-sm}px;
    padding: 2px 0;
    min-height: 20px;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
}

/* Status badge */
QLabel#status-badge {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 600;
}

/* Section header */
QLabel#section-header {
    font-size: ${font-size-h3}px;
    font-weight: 600;
    padding: ${spacing-xs}px 0;
}

/* Stat card */
QFrame#stat-card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: ${spacing-md}px;
}

QLabel#stat-value {
    font-size: ${font-size-stat-value}px;
    font-weight: 700;
}

QLabel#stat-label {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Validation badge */
QLabel#validation-badge {
    padding: ${spacing-xxs}px ${spacing-sm}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 500;
}

/* Header widget */
QWidget#header-widget {
    border-bottom: 1px solid;
}

/* Update banner */
QFrame#update-banner {
    border-radius: ${border-radius-default}px;
    margin: ${spacing-xxs}px ${spacing-xs}px;
    padding: ${spacing-xxs}px ${spacing-xs}px;
}

QFrame#update-banner QLabel {
    font-size: ${font-size-body-sm}px;
}

QFrame#update-banner QPushButton {
    border: 1px solid;
    border-radius: ${border-radius-small}px;
    padding: 2px 10px;
    font-size: ${font-size-caption}px;
}

QFrame#update-banner QPushButton:hover {
    border: 1px solid;
}

QFrame#update-banner QPushButton#dismissBtn {
    border: none;
    font-size: ${font-size-body}px;
    font-weight: bold;
    padding: 2px 6px;
}

/* Status bar styles */
QWidget#status-bar {
    font-size: ${font-size-body-sm}px;
    border-radius: ${border-radius-default}px;
}

QLabel#status-operation {
    font-size: ${font-size-body-sm}px;
    font-weight: 500;
}

QLabel#status-stats {
    font-size: ${font-size-caption}px;
}

QLabel#settings-save-status {
    color: ${color-success};
    font-weight: 500;
}

QLabel#status-indicator {
    padding: ${spacing-xxs}px ${spacing-xs}px;
    border-radius: 10px;
    font-size: ${font-size-caption}px;
    font-weight: 500;
}

QFrame#status-separator {
    max-width: 1px;
}

/* Queue item card */
QFrame#queue-item-card {
    border: 1px solid;
    border-radius: ${border-radius-large}px;
    padding: 0;
    margin: ${spacing-xxs}px 0;
}

QFrame#queue-item-card:hover {
    border-width: 2px;
}

QLabel#queue-item-title {
    font-size: ${font-size-h3}px;
    font-weight: 700;
}

QLabel#queue-item-path {
    font-size: ${font-size-caption}px;
    padding: 4px ${spacing-xxs}px;
    min-height: 20px;
    border-radius: ${border-radius-small}px;
}

QLabel#queue-item-stats {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    padding: 4px ${spacing-xxs}px;
    min-height: 20px;
    border-radius: ${border-radius-small}px;
}

/* Queue stats label - summary statistics */
QLabel#queue-stats {
    font-size: ${font-size-body-sm}px;
    font-weight: 500;
    padding: ${spacing-xxs}px 10px;
    border-radius: ${border-radius-default}px;
}

QLabel#queue-status-badge {
    padding: ${spacing-xxs}px 10px;
    border-radius: 10px;
    font-size: ${font-size-small}px;
    font-weight: 600;
    text-transform: uppercase;
}

QProgressBar#queue-progress {
    border: none;
    border-radius: 2px;
}

/* ============== SETTINGS TAB STYLES ============== */

/* Grouped settings navigator (D10). Group headings are inert rows: Qt paints
   them through the disabled state, which the colour rules below pick up. */
QListWidget#settings-nav {
    border: none;
    outline: none;
}

QListWidget#settings-nav::item {
    padding: ${spacing-xs}px ${spacing-sm}px ${spacing-xs}px ${spacing-md}px;
    border: none;
}

/* Headings are the disabled rows, and they outdent under their destinations. */
QListWidget#settings-nav::item:disabled {
    padding-left: ${spacing-xs}px;
}

/* Validation status labels */
QLabel#validation-status {
    font-size: ${font-size-caption}px;
    font-weight: 500;
    padding: ${spacing-xxs}px 0;
}

/* Helper/hint text. Dimming comes from the themed `color: ${color-text-muted}`
   rule further down; `opacity` was inert. */
QLabel#helper-text {
    font-size: ${font-size-small}px;
    font-style: italic;
    padding: 4px ${spacing-xs}px;
    min-height: 20px;
    border-radius: ${border-radius-small}px;
    margin-top: ${spacing-xxs}px;
}

/* Output-location value: small muted helper styling but NOT italic */
QLabel#output-location-value {
    font-size: ${font-size-small}px;
    padding: 4px ${spacing-xs}px;
    min-height: 20px;
    border-radius: ${border-radius-small}px;
    margin-top: ${spacing-xxs}px;
}

/* Read-only command display (copyable shell command in setup guidance) */
QLineEdit#command-text {
    font-family: monospace;
}

/* ============== THEME COLOR RULES ============== */
/* All colors use ${color-*} variables from the active JSON theme file. */

/* --- Base Colors --- */

QWidget {
    color: ${color-text};
}

QMainWindow {
    background-color: ${color-background};
}

QScrollArea {
    background-color: ${color-background};
}

QScrollArea > QWidget {
    background-color: ${color-background};
}

/* --- Buttons ---
   D41: accent is scarce. A button is quiet unless it is the one task action on
   its screen, whatever Qt has made the dialog default, a checked toggle, or the
   solid-red destruction of something unrecoverable. Ordering below matters: Qt
   follows CSS2.1 specificity, so an id selector outranks a bare state and the
   state rules that must win are spelled out per id. */

QPushButton {
    background-color: transparent;
    color: ${color-text};
    border-color: ${color-border};
}

QPushButton:hover {
    background-color: ${color-surface-hover};
}

QPushButton:pressed {
    background-color: ${color-surface-alt};
}

/* Ghost gives up its border too: a control that should barely be there. */
QPushButton#ghost {
    background-color: transparent;
    color: ${color-text};
    border-color: transparent;
}

QPushButton#ghost:hover {
    background-color: ${color-surface-hover};
}

/* `danger` is an outline. A removal you can redo does not need to shout. */
QPushButton#danger {
    background-color: transparent;
    color: ${color-error};
    border-color: ${color-error};
}

QPushButton#danger:hover {
    background-color: ${color-surface-hover};
    color: ${color-error-hover};
    border-color: ${color-error-hover};
}

/* `critical` is the only solid red in the app. Two call sites. */
QPushButton#critical {
    background-color: ${color-error};
    color: ${color-text-on-primary};
    border-color: ${color-error};
}

QPushButton#critical:hover {
    background-color: ${color-error-hover};
    border-color: ${color-error-hover};
}

/* The accent fill. `:default` is here so a dialog's Enter target keeps its
   visual weight whatever variant the call site asked for. */
QPushButton#primary,
QPushButton:default {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton#ghost:default,
QPushButton#danger:default {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton#primary:hover,
QPushButton:default:hover {
    background-color: ${color-primary-hover};
}

QPushButton#primary:pressed,
QPushButton:default:pressed {
    background-color: ${color-primary-pressed};
}

/* A checked toggle is state, and state is the other thing accent is for. */
QPushButton:checked,
QPushButton#ghost:checked {
    background-color: ${color-primary};
    color: ${color-text-on-primary};
    border-color: ${color-primary};
}

QPushButton:checked:hover,
QPushButton#ghost:checked:hover {
    background-color: ${color-primary-hover};
}

/* Unavailable reads the same in every role. */
QPushButton:disabled,
QPushButton#primary:disabled,
QPushButton#secondary:disabled,
QPushButton#ghost:disabled,
QPushButton#danger:disabled,
QPushButton#critical:disabled {
    background-color: ${color-disabled};
    color: ${color-text-on-primary};
    border-color: ${color-disabled};
}

/* Focus is the last word on the border, so it outlives every role above.
   `border-focus` equals `primary` in 26 of the 29 shipped themes, so on a
   filled button the ring is drawn in the colour that sits ON the fill. */
QPushButton:focus,
QPushButton#secondary:focus,
QPushButton#ghost:focus,
QPushButton#danger:focus {
    border-color: ${color-border-focus};
}

QPushButton#primary:focus,
QPushButton#critical:focus,
QPushButton:default:focus,
QPushButton:checked:focus {
    border-color: ${color-text-on-primary};
}

QToolButton#starToggle {
    color: ${color-text-muted};
}

QToolButton#starToggle:hover {
    color: ${color-text};
}

QToolButton#starToggle:checked {
    color: ${color-warning};
}

/* --- Input Fields --- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: ${color-input-bg};
    color: ${color-text};
    border-color: ${color-border};
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: ${color-border-focus};
    background-color: ${color-input-bg};
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: ${color-input-disabled-bg};
    color: ${color-text-disabled};
}

/* Qt has no `::placeholder` pseudo-element; `placeholder-text-color` on the
   widget itself is the supported spelling (it writes QPalette::PlaceholderText). */
QLineEdit {
    placeholder-text-color: ${color-text-muted};
}

/* --- Group Boxes --- */

QGroupBox {
    color: ${color-text};
    background-color: ${color-surface};
    border-color: ${color-border};
}

QGroupBox::title {
    color: ${color-text};
}

/* --- Tabs --- */

QTabWidget::pane {
    background-color: ${color-background};
    border: none;
}

QTabBar::tab {
    color: ${color-text-muted};
    background-color: transparent;
}

QTabBar::tab:hover {
    color: ${color-text};
    background-color: ${color-surface-hover};
}

/* The underline is the navigation indicator and keeps the accent; the label
   goes back to ordinary text, so the accent means "you are here" exactly once. */
QTabBar::tab:selected {
    color: ${color-text};
    background-color: transparent;
    border-bottom: 3px solid ${color-primary};
}

/* --- Text Edit / Log --- */

QTextEdit {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QTextEdit#log-widget {
    background-color: ${color-surface};
}

/* --- Progress Bar --- */

QProgressBar {
    background-color: ${color-border};
    color: ${color-text};
}

QProgressBar::chunk {
    background-color: ${color-primary};
}

/* --- Tables --- */

QTableWidget {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QTableWidget::item:hover {
    background-color: ${color-surface-hover};
}

QTableWidget::item:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QTableWidget::item:alternate {
    background-color: ${color-surface-alt};
    color: ${color-text};
}

QTableWidget::item:alternate:hover {
    background-color: ${color-surface-hover};
}

QTableWidget::item:alternate:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QTreeWidget {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QTreeWidget::item:hover {
    background-color: ${color-surface-hover};
}

QTreeWidget::item:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QTreeWidget::item:alternate {
    background-color: ${color-surface-alt};
    color: ${color-text};
}

QTreeWidget::item:alternate:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

QHeaderView::section {
    background-color: ${color-background};
    color: ${color-text};
    border-color: ${color-border};
}

QHeaderView::section:vertical {
    background-color: ${color-background};
    color: ${color-text};
    border-color: ${color-border};
}

QTableCornerButton::section {
    background-color: ${color-background};
    border: 1px solid ${color-border};
}

/* --- Scroll Bars --- */

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: transparent;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: ${color-scrollbar};
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: ${color-scrollbar-hover};
}

/* --- Status Bar --- */

QStatusBar {
    background-color: ${color-surface};
    color: ${color-text-muted};
    border-color: ${color-border};
}

/* --- Tooltips --- */

QToolTip {
    background-color: ${color-tooltip-bg};
    color: ${color-tooltip-text};
    border-color: ${color-tooltip-border};
}

/* --- Menus --- */

QMenu {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QMenu::item:selected {
    background-color: ${color-surface-hover};
    color: ${color-text};
}

QMenu::separator {
    background-color: ${color-border};
}

/* --- Menu bar (top strip + Report/Star/Discord corner buttons) ---
   Without an explicit QMenuBar rule, Qt stops native-styling the menu bar once
   an app-wide stylesheet is applied but does NOT fall back to the palette
   Window color, so on Windows the strip stays white while QWidget{color} paints
   the text near-white -> white-on-white in dark themes. Theme it from tokens. */
QMenuBar {
    background-color: ${color-background};
    color: ${color-text};
}

QMenuBar::item {
    background: transparent;
    color: ${color-text};
    padding: ${spacing-xs}px ${spacing-sm}px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: ${color-surface-hover};
    color: ${color-text};
}

/* The menu-bar corner container (Report/Star/Discord). Named so its background
   paints uniformly on Windows instead of relying on the transparent child
   showing the QMenuBar fill through. */
QWidget#menu_corner_widget {
    background-color: ${color-background};
}

/* Corner link buttons are autoRaise QToolButtons (transparent bg, no inline
   style); theme their text so they stay readable in dark mode. */
QToolButton#report_issue_button,
QToolButton#github_star_button,
QToolButton#discord_button {
    color: ${color-text};
    background-color: transparent;
    padding: ${spacing-xxs}px ${spacing-xs}px;
}

QToolButton#report_issue_button:hover,
QToolButton#github_star_button:hover,
QToolButton#discord_button:hover {
    color: ${color-text};
    background-color: ${color-surface-hover};
}

/* --- Combo Box Dropdown --- */

QComboBox QAbstractItemView {
    background-color: ${color-surface};
    color: ${color-text};
    border-color: ${color-border};
}

QComboBox QAbstractItemView::item:hover {
    background-color: ${color-surface-hover};
}

QComboBox QAbstractItemView::item:selected {
    background-color: ${color-table-selected-bg};
    color: ${color-table-selected-text};
}

/* --- Check Boxes & Radio Buttons --- */

QCheckBox, QRadioButton {
    color: ${color-text};
}

QCheckBox::indicator, QRadioButton::indicator {
    background-color: ${color-input-bg};
    border-color: ${color-border-subtle};
}

/* Hovering an unchecked box is not a state change; only checking it is. */
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: ${color-border};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: ${color-primary};
    border-color: ${color-primary};
}

/* --- Dialogs --- */

QDialog {
    background-color: ${color-surface};
    color: ${color-text};
}

QMessageBox {
    background-color: ${color-surface};
}

/* --- Custom Widgets --- */

/* Log header */
QWidget#log-header {
    background-color: ${color-surface-alt};
    border-bottom: 1px solid ${color-border};
}

/* Status badges */
QLabel#status-badge {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
    border-color: ${color-border-subtle};
}

QLabel#status-badge[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
    border-color: ${color-success};
}

QLabel#status-badge[status="warning"] {
    background-color: ${color-badge-warning-bg};
    color: ${color-badge-warning-text};
}

QLabel#status-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
    border-color: ${color-error};
}

QLabel#status-badge[status="info"],
QLabel#status-badge[status="checking"] {
    background-color: ${color-badge-info-bg};
    color: ${color-badge-info-text};
    border-color: ${color-info};
}

QLabel#status-badge[status="pending"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
}

/* Stat cards */
QFrame#stat-card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* A statistic is information, not an action: it reads as text. */
QLabel#stat-value {
    color: ${color-text};
}

QLabel#stat-label {
    color: ${color-text-muted};
}

/* Section headers */
QLabel#section-header {
    color: ${color-text};
}

/* Frames and cards */
QFrame#card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

QFrame#divider {
    background-color: ${color-divider};
}

/* Progress stats */
QLabel#progress-stats {
    color: ${color-text-muted};
}

/* --- Special States --- */

QLineEdit[error="true"] {
    border-color: ${color-error};
    border-width: 2px;
}

QLineEdit[success="true"] {
    border-color: ${color-success};
    border-width: 2px;
}

QLineEdit[warning="true"] {
    border-color: ${color-warning};
    border-width: 2px;
}

/* --- Validation Badges --- */

QLabel#validation-badge {
    border: 1px solid ${color-border};
}

QLabel#validation-badge[status="checking"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
    border-color: ${color-border};
}

QLabel#validation-badge[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
    border-color: ${color-success};
}

QLabel#validation-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
    border-color: ${color-error};
}

QLabel#validation-badge[status="warning"] {
    background-color: ${color-badge-warning-bg};
    color: ${color-badge-warning-text};
    border-color: ${color-warning};
}

/* --- Header Widget --- */

QWidget#header-widget {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* --- Update Banner --- */

QFrame#update-banner {
    background-color: ${color-update-banner-bg};
}

QFrame#update-banner QLabel {
    color: ${color-update-banner-text};
}

/* The banner paints its own two colours, so its buttons invert between them
   rather than reaching for a translucent white that only worked on one theme. */
QFrame#update-banner QPushButton {
    background-color: transparent;
    color: ${color-update-banner-text};
    border-color: ${color-update-banner-text};
}

QFrame#update-banner QPushButton:hover {
    background-color: ${color-update-banner-text};
    color: ${color-update-banner-bg};
}

/* --- Status Bar Widget --- */

QWidget#status-bar {
    background-color: ${color-surface};
    border-top: 1px solid ${color-border};
}

QLabel#status-operation[level="info"] {
    color: ${color-info};
}

QLabel#status-operation[level="success"] {
    color: ${color-success};
}

QLabel#status-operation[level="warning"] {
    color: ${color-warning};
}

QLabel#status-operation[level="error"] {
    color: ${color-error};
}

QLabel#status-stats {
    color: ${color-text-muted};
}

QLabel#status-indicator[status="success"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
}

QLabel#status-indicator[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
}

QFrame#status-separator {
    background-color: ${color-border};
}

/* --- Queue Item Card --- */

QFrame#queue-item-card {
    background-color: ${color-surface};
    border-color: ${color-border};
}

/* Pointing at a row is not selecting it: the hover surface says enough. */
QFrame#queue-item-card:hover {
    border-color: ${color-border};
    background-color: ${color-surface-hover};
}

QLabel#queue-item-title {
    color: ${color-text};
}

QLabel#queue-item-path {
    color: ${color-text-muted};
}

/* Entry counts are metadata about a row, not a call to act on it. */
QLabel#queue-item-stats {
    color: ${color-text-muted};
}

QLabel#queue-stats {
    background-color: ${color-surface-alt};
    color: ${color-text};
}

QLabel#queue-status-badge[status="pending"] {
    background-color: ${color-badge-pending-bg};
    color: ${color-badge-pending-text};
}

QLabel#queue-status-badge[status="processing"] {
    background-color: ${color-badge-info-bg};
    color: ${color-badge-info-text};
}

QLabel#queue-status-badge[status="complete"] {
    background-color: ${color-badge-success-bg};
    color: ${color-badge-success-text};
}

QLabel#queue-status-badge[status="error"] {
    background-color: ${color-badge-error-bg};
    color: ${color-badge-error-text};
}

/* --- Settings Tab --- */

QListWidget#settings-nav {
    background-color: transparent;
}

QListWidget#settings-nav::item:disabled {
    color: ${color-text-muted};
}

QListWidget#settings-nav::item:hover {
    background-color: ${color-surface-hover};
}

QListWidget#settings-nav::item:selected {
    color: ${color-primary};
    background-color: ${color-surface-hover};
}

QLabel#validation-status[status="success"] {
    color: ${color-success};
}

QLabel#validation-status[status="error"] {
    color: ${color-error};
}

QLabel#validation-status[status="checking"] {
    color: ${color-info};
}

QLabel#helper-text {
    color: ${color-text-muted};
}

QLabel#output-location-value {
    color: ${color-text-muted};
}

/* --- Sakura-specific: Decorative elements --- */

QLabel#decorative {
    color: ${color-decorative};
}
